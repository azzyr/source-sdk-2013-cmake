{
	"version": 6,
	"cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"architecture": { "value": "x64", "strategy": "external" },
			"toolset": { "value": "v143,host=x64", "strategy": "external" },
			"cacheVariables": { "BUILD_GROUP": "everything", "CMAKE_EXPORT_COMPILE_COMMANDS": true }
		},
		{ "name": "debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
		{ "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
		{
			"name": "dedicated",
			"inherits": "release",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"cacheVariables": { "BUILD_GROUP": "dedicated" }
		}
	]
}
