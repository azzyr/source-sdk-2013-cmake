#!/bin/bash

set -euo pipefail

script=$(readlink -f -- "$0")
pushd "$(dirname -- "$script")" > /dev/null

source sdk_container
run_in_sniper "$@"

build_type="release"
if [ $# -ne 0 ]; then
    if [[ "$1" != "debug" && "$1" != "release" ]]; then
        echo "Usage: $0 [debug|release]"
        exit 1
    fi
    build_type="$1"
fi

cmake --preset "$build_type"
cmake --build "build/$build_type"

popd
