function(target_use_server_base target)
	cmake_parse_arguments(PARSE_ARGV 1 ARG "" "" "EXCLUDE")
	set(USED_SOURCES ${SERVER_BASE_SOURCE_FILES})

	if (ARG_EXCLUDE)
		list(REMOVE_ITEM USED_SOURCES ${ARG_EXCLUDE})
	endif()

	target_sources(
		${target} PRIVATE
		${USED_SOURCES}
	)

	target_include_directories(
		${target} PRIVATE
		"${SERVER_BASE_DIR}"
		"${SRCDIR}/game/shared"
		"${SRCDIR}/utils/common"
		"${SRCDIR}/game/shared/econ"
		"${SRCDIR}/game/server/NextBot"
	)

	target_compile_definitions(
		${target} PRIVATE
		GAME_DLL
		VECTOR
		VERSION_SAFE_STEAM_API_INTERFACES
		PROTECTED_THINGS_ENABLE
		sprintf=use_Q_snprintf_instead_of_sprintf
		strncpy=use_Q_strncpy_instead
		_snprintf=use_Q_snprintf_instead
		INCLUDED_STEAM2_USERID_STRUCTS
		$<${IS_POSIX}:SWDS>
		$<${IS_WINDOWS}:fopen=dont_use_fopen>
	)

	target_compile_options(
		${target} PRIVATE
		"$<${IS_WINDOWS}:/wd4267;/wd4101>"
	)

	target_precompile_headers(
		${target} PRIVATE
		"${SERVER_BASE_DIR}/cbase.h"
	)

	set(NUT_DIR "${CMAKE_CURRENT_BINARY_DIR}/${target}_nut")
	foreach(nut vscript_server spawn_helper)
		add_custom_command(
			OUTPUT "${NUT_DIR}/${nut}_nut.h"
			COMMAND ${CMAKE_COMMAND} -E make_directory "${NUT_DIR}"
			COMMAND "${SRCDIR}/devtools/bin/texttoarray${CMAKE_HOST_EXECUTABLE_SUFFIX}" "${SERVER_BASE_DIR}/${nut}.nut" g_Script_${nut} > "${NUT_DIR}/${nut}_nut.h"
			DEPENDS "${SERVER_BASE_DIR}/${nut}.nut" "${SRCDIR}/devtools/bin/texttoarray${CMAKE_HOST_EXECUTABLE_SUFFIX}"
			DEPENDS_EXPLICIT_ONLY
			CODEGEN
		)
		target_sources(${target} PRIVATE "${NUT_DIR}/${nut}_nut.h")
	endforeach()
	target_include_directories(${target} PRIVATE "${NUT_DIR}")

	target_link_libraries(
		${target} PRIVATE
		$<${IS_WINDOWS}:winmm>

		choreoobjects
		dmxloader
		mathlib
		particles
		tier2
		tier3
		steam_api
	)

endfunction()