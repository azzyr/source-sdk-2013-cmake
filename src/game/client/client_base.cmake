function(target_use_client_base target)
	cmake_parse_arguments(PARSE_ARGV 1 ARG "" "" "EXCLUDE")
	set(USED_SOURCES ${CLIENT_BASE_SOURCE_FILES})

	if (ARG_EXCLUDE)
		list(REMOVE_ITEM USED_SOURCES ${ARG_EXCLUDE})
	endif()

	target_sources(
		${target} PRIVATE
		${USED_SOURCES}
	)

	target_include_directories(
		${target} PRIVATE
		"${CLIENT_BASE_DIR}"
		"${SRCDIR}/vgui2/include"
		"${SRCDIR}/vgui2/controls"
		"${SRCDIR}/game/shared"
		"${CLIENT_BASE_DIR}/game_controls"
		"${SRCDIR}/thirdparty/sixensesdk/include"
	)

	target_compile_definitions(
		${target} PRIVATE
		NO_STRING_T
		CLIENT_DLL
		VECTOR
		VERSION_SAFE_STEAM_API_INTERFACES
		PROTECTED_THINGS_ENABLE
		strncpy=use_Q_strncpy_instead
		_snprintf=use_Q_snprintf_instead
		INCLUDED_STEAM2_USERID_STRUCTS
		$<${IS_LINUX}:USE_WEBM_FOR_REPLAY>
	)

	target_compile_options(
		${target} PRIVATE
		"$<${IS_WINDOWS}:/wd4267;/wd4101>"
	)

	target_precompile_headers(
		${target} PRIVATE
		"${CLIENT_BASE_DIR}/cbase.h"
	)

	target_link_libraries(
		${target} PRIVATE

		$<${IS_LINUX}:rt>
		$<${IS_WINDOWS}:winmm>

		bitmap
		choreoobjects
		dmxloader
		mathlib
		matsys_controls
		particles
		tier1
		tier2
		tier3
		vgui_controls
		vtf
		steam_api
		libz
	)

	if (IS_WINDOWS AND BUILD_REPLAY)
		target_link_libraries(${target} PRIVATE wsock32 Ws2_32)
	endif()
endfunction()